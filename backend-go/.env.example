# BBtronic Go backend — example environment (placeholders only, never commit real values)
APP_ENV=development
PORT=8081

# Pooled Neon DSN in preview/production MUST use sslmode=verify-full.
# Rotate the credentials found in the Java application.properties: they are exposed.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
# Admin tooling only (migrations/inspection); do not set on the web project.
# DATABASE_DIRECT_URL=postgres://USER:PASSWORD@DIRECT-HOST:5432/DBNAME?sslmode=verify-full

PG_MAX_CONNS=2
PG_MIN_CONNS=0
PG_CONNECT_TIMEOUT=5
PG_QUERY_TIMEOUT=5
# PG_QUERY_EXEC_MODE=        # cache_statement (default) | exec | simple_protocol

ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HEADERS=false
AUTH_TOKEN_TTL_SECONDS=86400
# OPS_HEALTH_TOKEN=          # >= 32 random chars enables GET /readyz

REALTIME_MODE=websocket
STATE_POLL_ACTIVE_MS=2000
STATE_POLL_LOBBY_MS=5000
WS_ROTATE_SECONDS=270
PRESENCE_RENEW_SECONDS=15
PRESENCE_LEASE_SECONDS=45
DISCONNECT_GRACE_SECONDS=20
ROOM_IDLE_SECONDS=7200
RECEIPT_RETENTION_HOURS=24
MAX_CONNECTIONS_PER_PLAYER=4
MAX_ROOM_MEMBERS=30
HTTP_BODY_LIMIT=65536
WS_FRAME_LIMIT=16384
LOG_LEVEL=info
# BUILD_ID=                  # defaults to VERCEL_GIT_COMMIT_SHA
